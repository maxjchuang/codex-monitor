{
  "name": "@local/codex-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Monitor and drive the local Codex desktop app from the DSH sidebar.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "codex_ctl.py",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "verify-ui.mjs",
    "verify-markdown.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
